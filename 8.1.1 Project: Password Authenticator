# 01. Define the correct password
correct_password = "Password123"
# 02. Set the maximum number of attempts
max_attempts = 3
# 03. Initialize the attempt counter
attempt = 0

# 04. Start a loop to allow multiple attempts
while attempt < max_attempts:
    # 05. Prompt the user to enter their password
    password = input("Enter your password: ")
    
    # 06. Compare the entered password with the correct password
    if password == correct_password:
        print("Correct password!")
        # 07. Exit the loop if the password is correct
        break
    else:
        attempt += 1
        print("Incorrect password. Try again.")

# Optional: Indicate lock-out if attempts are exceeded
if attempt == max_attempts:
    print("Access Denied.")
